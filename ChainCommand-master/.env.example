# ChainCommand Configuration (prefix: CC_)
CC_API_KEY=change-me-in-production
CC_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CC_LLM_MODE=mock
CC_OPENAI_API_KEY=
CC_SIMULATION_SPEED=1.0
CC_LOG_LEVEL=INFO
CC_RANDOM_SEED=42
CC_RATE_LIMIT_PER_MINUTE=60

# AWS (optional)
CC_AWS_ENABLED=false
CC_AWS_REGION=ap-northeast-1
CC_AWS_S3_BUCKET=chaincommand-data
CC_AWS_REDSHIFT_HOST=
CC_AWS_REDSHIFT_PASSWORD=

# MLflow / MLOps (prefix: CC_)
CC_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chaincommand
CC_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
CC_MLFLOW_EXPERIMENT=chaincommand-inventory
CC_MLOPS_HORIZON=7
CC_MLOPS_MIN_IMPROVEMENT=0.0
MLFLOW_DISABLE_TELEMETRY=true
